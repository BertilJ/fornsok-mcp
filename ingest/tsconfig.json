{
	// Typkontroll av ingest/ (och de filer i src/ som ingest importerar):
	//   npm run type-check:ingest
	// Testerna för index och inläsning kontrolleras av test/tsconfig.json.
	// Node 22 kör ingest/ med typstrippning, som bara klarar syntax som kan
	// strykas (inga parameteregenskaper, enum, namespace). erasableSyntaxOnly
	// går inte att slå på här (worker-configuration.d.ts drar in hela src/);
	// test/ingest/cli.test.ts startar i stället cli.ts med Node.
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["./**/*.ts", "../worker-configuration.d.ts"]
}
