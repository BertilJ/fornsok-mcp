/**
 * Wrangler-konfiguration för Fornsök MCP – för LOKAL utveckling (`npm run dev`).
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Förvaret är publikt: inga konto-id, resurs-id:n, domäner, Access-uppgifter
 * eller e-postadresser här (SPEC 13). Driftsättning görs med en ospårad
 * `wrangler.local.jsonc` (mall: wrangler.local.example.jsonc):
 *   npx wrangler deploy -c wrangler.local.jsonc
 *
 * Utan ACCESS_TEAM_DOMAIN/ACCESS_AUD svarar Workern 401 på allt. Lokalt sätts
 * ACCESS_DEV_BYPASS="true" i `.dev.vars` (ospårad) för att slippa JWT – det
 * gäller bara anrop till localhost. Bindningarna CACHE, RATE_LIMITER, DB,
 * VECTORIZE och AI är valfria för koden och saknas här.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fornsok-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// Kontaktväg i User-Agent mot RAÄ (SPEC 9.1). Sätt till din egen vid driftsättning.
		"CONTACT_URL": "https://github.com/BertilJ/fornsok-mcp",
	},
	"observability": {
		"enabled": true,
	},
}
